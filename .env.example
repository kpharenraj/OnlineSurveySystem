# Leave the database variables empty to use the local H2 database.
SUPABASE_DB_URL=
SUPABASE_DB_USERNAME=
SUPABASE_DB_PASSWORD=

# Use at least 32 random bytes in production. Prefix with "base64:" only
# when the value that follows is standard Base64.
JWT_SECRET=

# Set only while creating the first administrator account, then remove both.
ADMIN_EMAIL=
ADMIN_BOOTSTRAP_TOKEN=

# The browser UI is served from this application by default.
CORS_ALLOWED_ORIGIN=http://localhost:8080
